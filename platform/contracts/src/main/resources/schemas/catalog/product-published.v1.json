{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductPublished",
  "description": "A product became visible in the public catalog and can be bought.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "occurredOn", "productId", "sku", "name", "price", "currency", "sellerId"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "description": "Unique id of the event." },
    "occurredOn": { "type": "string", "format": "date-time", "description": "ISO-8601 instant at which the product was published." },
    "productId": { "type": "string", "format": "uuid" },
    "sku": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "minimum": 0, "description": "Selling price, a decimal number in the currency." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO-4217 currency code." },
    "sellerId": { "type": "string", "minLength": 1 }
  }
}
