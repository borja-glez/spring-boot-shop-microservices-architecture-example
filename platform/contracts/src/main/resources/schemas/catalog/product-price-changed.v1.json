{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductPriceChanged",
  "description": "The selling price of a published product changed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "occurredOn", "productId", "oldPrice", "newPrice", "currency"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "description": "Unique id of the event." },
    "occurredOn": { "type": "string", "format": "date-time", "description": "ISO-8601 instant at which the price changed." },
    "productId": { "type": "string", "format": "uuid" },
    "oldPrice": { "type": "number", "minimum": 0 },
    "newPrice": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO-4217 currency code." }
  }
}
