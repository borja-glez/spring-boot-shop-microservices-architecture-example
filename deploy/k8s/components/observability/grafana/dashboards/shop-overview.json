          "expr": "sum by (service_name) (rate(http_server_requests_milliseconds_count{service_name=~\"$service\",uri!~\"/actuator.*|.*/stream|/api/notifications/[*][*]\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true
