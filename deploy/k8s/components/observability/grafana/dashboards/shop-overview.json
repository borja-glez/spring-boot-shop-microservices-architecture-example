      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_milliseconds_bucket{service_name=\"gateway-service\",uri!~\"/actuator.*|.*/stream|/api/notifications/[*][*]\"}[5m])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
